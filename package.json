{
  "name": "dsh-origin-plugin",
  "version": "2.0.3",
  "description": "Drive Origin scientific plotting from DeepSeek Harness AI chat via MCP - 28 tools, styled multi-series plots, inline image preview, statistics batch (t/ANOVA/PCA/survival), stable error codes. Market-safe bundle: self-locating server path, fail-open startup, mcp-client dependency.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.7"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fantasality/dsh-origin-plugin.git"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "requirements.txt",
    "origin_engine.py",
    "origin_mcp_server.py",
    "origin_errors.py",
    "plot_style.py",
    "origin_analysis.py",
    "demo_call.py",
    "run_origin_server.cmd",
    "skills",
    "docs",
    "smoke"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "origin",
    "originpro",
    "scientific-plotting",
    "data-visualization",
    "cordis"
  ],
  "dsh": {
